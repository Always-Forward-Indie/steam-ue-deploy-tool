<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SteamUEDeployTool.Desktop.Controls.LogEntryControl">
    <Border Padding="4,2">
        <TextBlock Name="LogText" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" />
    </Border>
</UserControl>
