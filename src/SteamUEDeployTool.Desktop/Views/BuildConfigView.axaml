<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SteamUEDeployTool.Desktop.ViewModels"
             xmlns:m="clr-namespace:SteamUEDeployTool.Core.Models;assembly=SteamUEDeployTool.Core"
             x:Class="SteamUEDeployTool.Desktop.Views.BuildConfigView">
    <ScrollViewer Margin="24">
        <StackPanel Spacing="16" MaxWidth="700">
            <TextBlock Text="Build Configuration" FontSize="24" FontWeight="Bold" Foreground="White" />

            <Border Background="#2D2D2D" CornerRadius="8" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Saved Profiles" FontSize="14" Foreground="#CCCCCC" />
                    <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                             Height="120">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="m:BuildProfile">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Name}" Width="200" />
                                    <TextBlock Text="{Binding Platform}" />
                                    <TextBlock Text=" - " />
                                    <TextBlock Text="{Binding BuildConfiguration}" Foreground="#888" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{Binding SaveCommand}" Content="Save" Width="80" />
                        <Button Command="{Binding DeleteCommand}" Content="Delete" Width="80" />
                        <Button Command="{Binding ClearFormCommand}" Content="Clear" Width="80" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="#2D2D2D" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Profile Settings" FontSize="14" Foreground="#CCCCCC" />

                    <StackPanel Spacing="2">
                        <TextBlock Text="Profile Name" Foreground="#888" FontSize="12" />
                        <TextBox Text="{Binding Name}" Watermark="e.g. Windows Shipping Build" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="UProject Path" Foreground="#888" FontSize="12" />
                            <TextBlock Text="(?)" Foreground="#0078D4" FontSize="11"
                                       ToolTip.Tip="Path to your .uproject file. This tells the tool which project to build and which engine version to use." />
                        </StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Command="{Binding BrowseUProjectCommand}"
                                    Content="..." Width="32" Margin="4,0,0,0" />
                            <TextBox Text="{Binding UProjectPath}" Watermark="D:\MyProject\MyProject.uproject" />
                        </DockPanel>
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Custom Engine Path" Foreground="#888" FontSize="12" />
                            <TextBlock Text="(?)" Foreground="#0078D4" FontSize="11"
                                       ToolTip.Tip="Optional. If the tool can't auto-detect your engine, point it to the engine folder manually. e.g. C:\Program Files\Epic Games\UE_5.4" />
                        </StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Command="{Binding BrowseEnginePathCommand}"
                                    Content="..." Width="32" Margin="4,0,0,0" />
                            <TextBox Text="{Binding CustomEnginePath}"
                                     Watermark="Leave empty to auto-detect from .uproject" />
                        </DockPanel>
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Target Platform" Foreground="#888" FontSize="12" />
                            <TextBlock Text="(?)" Foreground="#0078D4" FontSize="11"
                                       ToolTip.Tip="Platform to build for. Win64 = Windows 64-bit, Linux = Linux dedicated server, Mac = macOS client" />
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding Platforms}"
                                  SelectedIndex="{Binding SelectedPlatformIndex}" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Build Configuration" Foreground="#888" FontSize="12" />
                            <TextBlock Text="(?)" Foreground="#0078D4" FontSize="11"
                                       ToolTip.Tip="Development = debug-friendly build, Shipping = optimized final build for Steam. Use Development for testing, Shipping for release." />
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding BuildConfigurations}"
                                  SelectedIndex="{Binding SelectedBuildConfigurationIndex}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <CheckBox IsChecked="{Binding Cook}" Content="Cook Content"
                                  ToolTip.Tip="Cooks (processes) all game assets before packaging. Required for a distributable build." />
                        <CheckBox IsChecked="{Binding CleanBuild}" Content="Clean Build"
                                  ToolTip.Tip="Passes -clean to UAT. For a full cache reset, use the Deep Clean button below." />
                        <CheckBox IsChecked="{Binding BundleVCRedist}" Content="Bundle VC++ Redist"
                                  ToolTip.Tip="Copies msvcp140.dll, vcruntime140.dll, vcruntime140_1.dll into Binaries/Win64 so players don't need to install Visual C++ Redistributable separately." />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{Binding DeepCleanCommand}" Content="Deep Clean" Width="110"
                                ToolTip.Tip="Deletes Intermediate, Binaries, Saved, and DerivedDataCache folders. Fixes stale cache errors after engine upgrades. Required after switching engine versions (e.g. 5.3 -> 5.7)." />
                        <TextBlock Text="Deletes Intermediate, Binaries, Saved, DerivedDataCache"
                                   FontSize="11" Foreground="#888" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Extra UAT Arguments" Foreground="#888" FontSize="12" />
                            <TextBlock Text="(?)" Foreground="#0078D4" FontSize="11"
                                       ToolTip.Tip="Additional command-line arguments passed to Unreal Automation Tool. Advanced users only. e.g. -NoPause -UTF8Output" />
                        </StackPanel>
                        <TextBox Text="{Binding ExtraArgs}" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Output Path Override" Foreground="#888" FontSize="12" />
                            <TextBlock Text="(?)" Foreground="#0078D4" FontSize="11"
                                       ToolTip.Tip="Where to place the built files. Leave empty to use the default (Project/Saved/StagedBuilds)." />
                        </StackPanel>
                        <TextBox Text="{Binding OutputPathOverride}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{Binding ValidateCommand}" Content="Validate" Width="100" />
                    </StackPanel>

                    <Border Background="#333333" CornerRadius="4" Padding="8"
                            IsVisible="{Binding ValidationMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Grid RowDefinitions="Auto,*">
                            <Button Grid.Row="0" FontSize="10" Height="22" Padding="8,0" Content="Copy"
                                    Command="{Binding CopyErrorsCommand}" HorizontalAlignment="Right"
                                    Margin="0,0,0,4" />
                            <ScrollViewer Grid.Row="1" MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding ValidationMessage}" FontSize="12"
                                           Foreground="#CCCCCC" TextWrapping="Wrap"
                                           FontFamily="Cascadia Code,Consolas,monospace" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
