<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SteamUEDeployTool.Desktop.Views.LogView">
    <Grid Margin="24" RowDefinitions="Auto,Auto,*">
        <TextBlock Grid.Row="0" Text="Logs" FontSize="16" Foreground="White" />
        <TextBox Grid.Row="1" Watermark="Search logs..." Margin="0,8" />
        <ScrollViewer Grid.Row="2" Background="#1E1E1E" Padding="8">
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Message}" FontFamily="Cascadia Code,Consolas,monospace"
                                   FontSize="12" Foreground="#CCCCCC" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
